import java.util.*;
class Solution {
    public List<Integer> majorityElement(int[] nums) {
        int n = nums.length; 
        List<Integer> re = new ArrayList<>();
        
        Arrays.sort(nums);
        int count = 1 ;
        for(int i = 0 ; i < n ; i++){
            if (i == n-1 || nums[i] != nums[i+1]){
                if ( count > n / 3){
                    re.add(nums[i]);
                } 
                count = 1 ;
            }else {
                count ++ ;
            }
        }
        return re ;
    }
}
